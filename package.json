{
  "name": "javmem-dsh-plugin",
  "version": "0.3.0",
  "description": "DeepSeek Harness (Tobs) plugin: read-only memory tools from memv2 and Javis for the Bots you list (one combined tool or the two single-store ones), with no per-Bot private MCP card.",
  "license": "MIT",
  "author": "xuxiaoxiang0721-tech",
  "homepage": "https://github.com/xuxiaoxiang0721-tech/javmem-dsh-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuxiaoxiang0721-tech/javmem-dsh-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/xuxiaoxiang0721-tech/javmem-dsh-plugin/issues"
  },
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs"
  },
  "files": [
    "index.mjs",
    "catalog.json",
    "cordis.patch.yml",
    "mcp/",
    "scripts/",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/test-plugin.mjs",
    "catalog": "node scripts/make-catalog.mjs",
    "compat": "node scripts/check-compat.mjs",
    "pack": "node scripts/pack.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3 <1.0.0-0 || >=0.2.2-0 <1.0.0-0 || >=0.2.3-0 <1.0.0-0 || >=0.3.0-0 <1.0.0-0"
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.3 <1.0.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "tobs",
    "memory",
    "mcp",
    "memv2",
    "graphiti"
  ]
}
